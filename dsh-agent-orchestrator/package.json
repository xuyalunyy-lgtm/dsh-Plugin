{
  "name": "@local/dsh-agent-orchestrator",
  "version": "0.3.1",
  "private": true,
  "description": "结构化任务图与事件驱动多智能体调度：依赖、资源所有权、并发队列、持久状态及只读任务看板",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "policy.js",
    "runtime-adapter.js",
    "store.js",
    "scheduler.js",
    "controller.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check policy.js && node --check runtime-adapter.js && node --check store.js && node --check scheduler.js && node --check controller.js && node --check client.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "license": "MIT"
}
