{
  "name": "dsh-document-search",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "文档搜索：PDF 与 Markdown 当前文档全文查找、高亮及页码定位",
  "exports": {".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "THIRD-PARTY-NOTICES.txt"],
  "scripts": {"build": "node build.mjs", "test": "node --test tests/*.test.mjs"},
  "devDependencies": {"esbuild": "0.25.12", "pdfjs-dist": "5.4.296"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar-documentpreview", "@deepseek-ai/dsh-client-locale"]}}
}
