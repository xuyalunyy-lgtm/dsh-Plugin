{
  "name": "@local/dsh-qinglan-theme",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "青岚主题：柔和配色与可替换的本地背景图片",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
