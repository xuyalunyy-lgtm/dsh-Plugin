{
  "name": "dsh-focus-calendar",
  "version": "1.3.0",
  "description": "专注日历：安全待办、历史未完成、任务专注、健康工作时段与勿扰、备份恢复",
  "private": true,
  "type": "module",
  "exports": {".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
  "files": ["index.js", "state.js", "health-policy.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "RESTORE.md"],
  "dependencies": {"zod": "4.4.3"},
  "bundledDependencies": ["zod"],
  "scripts": {"test": "node --test *.test.js", "check": "node --check index.js && node --check state.js && node --check health-policy.js && node --check client.js"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-locale"]}
  }
}
