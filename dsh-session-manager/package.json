{
  "name": "dsh-session-manager",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "会话管理：多选批量归档、空会话识别、工作区隐藏/显示、新建、安全迁移历史及恢复。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "controller.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "validate.mjs"],
  "dependencies": {"zod": "4.4.3"},
  "scripts": {"test": "node --test", "check": "node --check index.js && node --check controller.js && node --check client.js && node validate.mjs"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
